# Nexus Backend Environment Configuration
# Copy this file to .env to customize settings for your local environment.
# When .env is absent, the backend runs with safe defaults.

# Environment mode: development, testing, or production
ENVIRONMENT=development

# Database connection URL
# Default SQLite database is stored locally inside the backend directory: backend/nexus.db
DATABASE_URL=sqlite:///nexus.db

# Allowed CORS origins for frontend client dev servers (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
